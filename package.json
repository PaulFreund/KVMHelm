{
  "name": "kvmhelm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "bin": {
    "kvmhelm": "scripts/kvmhelm.mjs"
  },
  "scripts": {
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "dev": "cargo run --locked --features embedded-web -- serve --dev",
    "build": "npm run build:web",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:native": "cargo build --locked --release --features embedded-web",
    "package:native": "node scripts/package-native.mjs",
    "start": "node --env-file-if-exists=.env scripts/kvmhelm.mjs serve",
    "cli": "node --env-file-if-exists=.env scripts/kvmhelm.mjs",
    "test": "npm run test:web && cargo test --locked --features embedded-web",
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "test:reference": "node scripts/prepare-reference.mjs --test",
    "check": "vue-tsc --noEmit",
    "test:web": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@vitejs/plugin-vue": "6.0.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "opusscript": "0.1.1",
    "pinia": "4.0.3",
    "prettier": "3.9.6",
    "reka-ui": "2.10.4",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "vue-tsc": "3.3.11",
    "werift": "0.24.4",
    "ws": "8.21.3",
    "zod": "4.5.4"
  }
}
