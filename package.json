{
  "name": "kvmhelm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "bin": {
    "kvmhelm": "dist/server/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx server/cli.ts serve --dev",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/cli.js serve",
    "cli": "tsx server/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "ffmpeg-static": "5.3.0",
    "opusscript": "0.1.1",
    "pinia": "4.0.3",
    "reka-ui": "2.10.4",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "undici": "8.10.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "werift": "0.24.4",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
