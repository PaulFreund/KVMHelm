{
  "protocolVersion": "2025-11-25",
  "versions": [
    "2025-11-25",
    "2025-06-18",
    "2025-03-26",
    "2024-11-05",
    "2024-10-07"
  ],
  "serverInfo": {
    "name": "KVMHelm",
    "version": "0.1.0"
  },
  "capabilities": {
    "tools": {
      "listChanged": true
    }
  },
  "instructions": "Use list_computers, then open_computer. Observe, act in short batches, observe again. Coordinates are pixels in the returned image. Copy frame_id, view_id and input_revision from the latest frame into computer.reference. After acquiring control separately, get a new screenshot. Use a new request_id per operation; reuse it only for an identical retry. Never blindly repeat uncertain input. Close sessions when finished. When the user asks to see the screen or a visual result, explicitly display the returned image in your user-visible response using your client's supported image attachment/rendering mechanism. An image in a tool result may be visible only to you. Forward the actual image content; do not replace it with a description or invent a URL. If your client cannot display it, say so; never claim an image is shown unless you included it. Do not upload screenshots to an external service merely to display them.",
  "tools": [
    {
      "name": "list_computers",
      "description": "List available computers and capabilities.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "ok",
          "frames"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "open_computer",
      "description": "Open an observe or exclusive control session and get its screen; control requires request_id. When the user asks to see the screen or a visual result, explicitly display the returned image in your user-visible response using your client's supported image attachment/rendering mechanism. An image in a tool result may be visible only to you. Forward the actual image content; do not replace it with a description or invent a URL. If your client cannot display it, say so; never claim an image is shown unless you included it. Do not upload screenshots to an external service merely to display them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "computer_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "observe",
              "control"
            ]
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profile": {
            "type": "string",
            "enum": [
              "auto",
              "active",
              "overview",
              "warm"
            ]
          }
        },
        "required": [
          "computer_id",
          "mode"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "ok",
          "frames"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "computer",
      "description": "Run ordered actions; return the screen by default. The device applies a minimum delay after the last input before observing (default 30 ms); later observations do not restart it. Use wait(duration_ms) between actions when needed. On timing failures increase the relevant wait by 50 ms until visually stable; after 5 verified successes reduce by 25 ms toward 0. If a lower value fails, restore the last stable value and retry lowering after 5 successes. Sent/ACK is not visual success. Never replay uncertain input automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reference": {
            "type": "object",
            "properties": {
              "frame_id": {
                "type": "string"
              },
              "view_id": {
                "type": "string"
              },
              "input_revision": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "frame_id",
              "view_id",
              "input_revision"
            ],
            "additionalProperties": false
          },
          "actions": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "click"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "button": {
                      "default": "left",
                      "type": "string",
                      "enum": [
                        "left",
                        "right",
                        "middle"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "double_click"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "move"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "drag"
                    },
                    "path": {
                      "minItems": 2,
                      "maxItems": 256,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "scroll"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "scroll_x": {
                      "type": "integer",
                      "minimum": -1000,
                      "maximum": 1000
                    },
                    "scroll_y": {
                      "type": "integer",
                      "minimum": -1000,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y",
                    "scroll_x",
                    "scroll_y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "keypress"
                    },
                    "keys": {
                      "minItems": 1,
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    }
                  },
                  "required": [
                    "type",
                    "keys"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "type"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "wait"
                    },
                    "duration_ms": {
                      "default": 100,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "screenshot"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "observation": {
            "type": "object",
            "properties": {
              "mode": {
                "default": "after_actions",
                "type": "string",
                "enum": [
                  "after_actions",
                  "none"
                ]
              },
              "timeout_ms": {
                "default": 1500,
                "type": "integer",
                "minimum": 50,
                "maximum": 10000
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "session_id",
          "request_id",
          "reference",
          "actions"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "ok",
          "frames"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "computer_screenshot",
      "description": "Get the current screen without input; max_age_ms allows a cached image. When the user asks to see the screen or a visual result, explicitly display the returned image in your user-visible response using your client's supported image attachment/rendering mechanism. An image in a tool result may be visible only to you. Forward the actual image content; do not replace it with a description or invent a URL. If your client cannot display it, say so; never claim an image is shown unless you included it. Do not upload screenshots to an external service merely to display them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "max_age_ms": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "timeout_ms": {
            "default": 1500,
            "type": "integer",
            "minimum": 50,
            "maximum": 10000
          }
        },
        "required": [
          "session_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "ok",
          "frames"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "computer_control",
      "description": "Acquire, renew or release exclusive control of your session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation": {
            "type": "string",
            "enum": [
              "acquire",
              "renew",
              "release"
            ]
          }
        },
        "required": [
          "session_id",
          "request_id",
          "operation"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "ok",
          "frames"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "close_computer",
      "description": "Close your session and release control.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "ok",
